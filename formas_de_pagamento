    desconto = 0
    percentual = 0
    nome_forma = "Cartão"
else:
    print("Opção inválida!")
    desconto = 0
    percentual = 0
    nome_forma = "Inválida"

valor_final = valor - desconto

print("--------------------")
print(f"Forma: {nome_forma}")
