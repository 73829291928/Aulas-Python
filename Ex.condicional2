Idade= ano_atual - ano_nascimento

#Saída
print("-----------------")
print(f"Olá, {nome}! Você tem {Idade} anos, portanto você é ")

if Idade <=17:
    print ("Menor de idade") 
    
else:
    print ("Maior de idade")
    if carteira== "1":
        print ("Pode dirigir")
    else: 
         print ("Não pode dirigir")